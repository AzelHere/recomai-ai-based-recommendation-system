# The start-local.ps1 helper creates .env with random passwords automatically.
# If setting this up manually, replace both example values with unique secrets.
MYSQL_DATABASE=ai_recommendation_system
DB_USERNAME=recommendation_app
DB_PASSWORD=replace-with-a-unique-local-secret
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-secret
MYSQL_HOST_PORT=3307
APP_HOST_PORT=8080
SESSION_COOKIE_SECURE=false
APP_PUBLIC_URL=http://localhost:8080

# Local development email capture (Mailpit UI at http://localhost:8025).
# For production, set APP_PUBLIC_URL to the trusted HTTPS origin and SMTP values below.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=no-reply@recomai.local
MAILPIT_HOST_PORT=8025
PASSWORD_RESET_COOLDOWN_SECONDS=60
COMPOSE_PROFILES=local-mail

# Optional personalization tuning. Search starts as a weak signal.
RECOMMENDATION_FAMILIAR_SHARE=0.70
RECOMMENDATION_RELATED_SHARE=0.20
RECOMMENDATION_DISCOVERY_SHARE=0.10
SIGNAL_VIEW=0.15
SIGNAL_CLICK=0.50
SIGNAL_READ_PROGRESS=0.65
SIGNAL_SAVE=1.00
SIGNAL_PURCHASE=1.25
SIGNAL_LIKE=1.00
SIGNAL_DISLIKE=-1.25
SIGNAL_HIDE=-1.50
SIGNAL_SHARE=1.50
SIGNAL_SKIP=-0.25
SIGNAL_MORE_LIKE=1.25
SIGNAL_SEARCH=0.12
FLYWAY_BASELINE_ON_MIGRATE=false
