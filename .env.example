# The start-local.ps1 helper creates .env with random passwords automatically.
# If setting this up manually, replace both example values with unique secrets.
MYSQL_DATABASE=ai_recommendation_system
DB_USERNAME=recommendation_app
DB_PASSWORD=replace-with-a-unique-local-secret
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-secret
MYSQL_HOST_PORT=3307
APP_HOST_PORT=8080
SESSION_COOKIE_SECURE=false
