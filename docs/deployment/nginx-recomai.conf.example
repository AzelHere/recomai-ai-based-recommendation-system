# Template only: replace hostname/certificate paths and validate with nginx -t.
server {
    listen 80;
    server_name learning.example.invalid;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name learning.example.invalid;
    ssl_certificate /etc/ssl/recomai/fullchain.pem;
    ssl_certificate_key /etc/ssl/recomai/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 3m;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }
}
